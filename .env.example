# FactoryPulse Environment Configuration
PROJECT_NAME=FactoryPulse
VERSION=1.0.0
API_V1_STR=/api/v1

# MySQL Database Settings (Defaults to MySQL 8 on port 3306)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=MySQL1234@
MYSQL_DB=factorypulse_db

# Direct SQLAlchemy URL (Optional override)
# If MySQL is not reachable, the system safely falls back to SQLite (sqlite:///./factorypulse.db) with clear instructions
DATABASE_URL=mysql+pymysql://root:MySQL1234@localhost:3306/factorypulse_db?charset=utf8mb4

# Security / JWT
SECRET_KEY=factorypulse_hackathon_jwt_secret_2026_super_secure_key
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Reproducibility Seed
RANDOM_SEED=20261022
